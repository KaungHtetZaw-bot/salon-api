// Salon Shop — database schema
// 16 tables: users, refresh_tokens, device_tokens, categories, services,
// staff_profiles, staff_services, portfolio_items, working_hours, time_off,
// appointments, reviews, loyalty_transactions, rewards, redemptions,
// salon_settings

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Platform {
  IOS
  ANDROID
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  APP
  WALK_IN
}

enum CancelledBy {
  CUSTOMER
  STAFF
  ADMIN
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum RedemptionStatus {
  ISSUED
  USED
  EXPIRED
  CANCELLED
}

// ─────────────────────── Identity & Access ───────────────────

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String?    @unique
  passwordHash String?    @map("password_hash")
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @map("avatar_url")
  locale       String     @default("en")

  // Reserved for v2 social login — populated by a third-party auth lib later.
  googleId   String? @unique @map("google_id")
  appleId    String? @unique @map("apple_id")
  facebookId String? @unique @map("facebook_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  deviceTokens        DeviceToken[]
  staffProfile        StaffProfile?
  customerAppointments Appointment[]      @relation("CustomerAppointments")
  reviews              Review[]
  loyaltyTransactions  LoyaltyTransaction[]
  redemptions          Redemption[]
  notifications        Notification[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  fcmToken   String   @unique @map("fcm_token")
  platform   Platform
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// In-app notification center — every push attempt is logged here,
// so users never miss anything even if they have no device registered.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────── Catalog ─────────────────────────

model Category {
  id           String  @id @default(uuid())
  name         String
  imageUrl     String? @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  services Service[]

  // name uniqueness among ACTIVE rows via partial index (see migration
  // `partial_unique_names`) — lets soft-deleted rows release their names.
  @@index([name])
  @@map("categories")
}

model Service {
  id              String  @id @default(uuid())
  categoryId      String  @map("category_id")
  name            String
  description     String?
  basePrice       Decimal @db.Decimal(10, 2) @map("base_price")
  baseDurationMin Int     @map("base_duration_min")
  imageUrl        String? @map("image_url")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  staffLinks     StaffService[]
  appointments   Appointment[]
  portfolioItems PortfolioItem[]
  rewards        Reward[]

  // (category_id, name) uniqueness among ACTIVE rows via partial index
  @@index([categoryId, name])
  @@map("services")
}

model StaffProfile {
  id             String  @id
  title          String?
  bio            String?
  commissionRate Decimal @default(0) @db.Decimal(5, 2) @map("commission_rate")
  isBookable     Boolean @default(true) @map("is_bookable")
  hireDate       DateTime? @map("hire_date")
  isActive       Boolean @default(true) @map("is_active")

  user           User             @relation(fields: [id], references: [id], onDelete: Cascade)
  services       StaffService[]
  workingHours   WorkingHours[]
  timeOff        TimeOff[]
  appointments   Appointment[]    @relation("StaffAppointments")
  portfolioItems PortfolioItem[]
  reviews        Review[]

  @@map("staff_profiles")
}

model StaffService {
  staffProfileId String   @map("staff_profile_id")
  serviceId      String   @map("service_id")
  customDuration Int?     @map("custom_duration")
  customPrice    Decimal? @db.Decimal(10, 2) @map("custom_price")

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffProfileId, serviceId])
  @@map("staff_services")
}

model PortfolioItem {
  id             String  @id @default(uuid())
  staffProfileId String  @map("staff_profile_id")
  serviceId      String? @map("service_id")
  imageUrl       String  @map("image_url")
  caption        String?
  displayOrder   Int     @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id])

  @@index([staffProfileId])
  @@map("portfolio_items")
}

// ────────────────────────── Scheduling ───────────────────────

model WorkingHours {
  id             String @id @default(uuid())
  staffProfileId String @map("staff_profile_id")
  weekday        Int // 0 = Sunday … 6 = Saturday
  startMinute    Int    @map("start_minute") // minutes from midnight, e.g. 540 = 09:00
  endMinute      Int    @map("end_minute") // e.g. 1080 = 18:00

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, weekday])
  @@map("working_hours")
}

model TimeOff {
  id             String   @id @default(uuid())
  staffProfileId String   @map("staff_profile_id")
  startsAt       DateTime @db.Timestamptz() @map("starts_at")
  endsAt         DateTime @db.Timestamptz() @map("ends_at")
  reason         String?

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, startsAt])
  @@map("time_off")
}

model Appointment {
  id             String            @id @default(uuid())
  customerId     String            @map("customer_id")
  staffProfileId String            @map("staff_profile_id")
  serviceId      String            @map("service_id")
  scheduledFor   DateTime          @db.Timestamptz() @map("scheduled_for")
  endsAt         DateTime          @db.Timestamptz() @map("ends_at")
  status         AppointmentStatus @default(PENDING)
  source         AppointmentSource @default(APP)
  priceCharged   Decimal           @db.Decimal(10, 2) @map("price_charged")
  notes          String?
  cancelledBy    CancelledBy?      @map("cancelled_by")
  cancelReason   String?           @map("cancel_reason")
  cancelledAt    DateTime?         @map("cancelled_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  customer     User         @relation("CustomerAppointments", fields: [customerId], references: [id])
  staffProfile StaffProfile @relation("StaffAppointments", fields: [staffProfileId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  review       Review?
  loyaltyPoints LoyaltyTransaction[]

  @@index([staffProfileId, scheduledFor])
  @@index([customerId, status])
  @@index([status, scheduledFor])
  @@map("appointments")
}

// ────────────────────────── Engagement ───────────────────────

model Review {
  id             String  @id @default(uuid())
  appointmentId  String  @unique @map("appointment_id") // one review per completed visit
  customerId     String  @map("customer_id")
  staffProfileId String  @map("staff_profile_id")
  rating         Int // 1..5
  comment        String?
  staffReply     String? @map("staff_reply")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer     User         @relation(fields: [customerId], references: [id])
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])

  @@index([staffProfileId])
  @@map("reviews")
}

// Ledger of every points change — balance is always SUM(points).
model LoyaltyTransaction {
  id            String                 @id @default(uuid())
  customerId    String                 @map("customer_id")
  appointmentId String?                @map("appointment_id")
  points        Int // positive = earned, negative = spent/removed
  type          LoyaltyTransactionType
  description   String?
  createdAt     DateTime               @default(now()) @map("created_at")

  customer    User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([customerId])
  @@map("loyalty_transactions")
}

model Reward {
  id           String  @id @default(uuid())
  name         String
  description  String?
  pointsCost   Int     @map("points_cost")
  serviceId    String? @map("service_id") // free-service rewards point at a service
  discountPct  Int?    @map("discount_pct")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  service     Service?     @relation(fields: [serviceId], references: [id])
  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id          String           @id @default(uuid())
  customerId  String           @map("customer_id")
  rewardId    String           @map("reward_id")
  status      RedemptionStatus @default(ISSUED)
  redeemedAt  DateTime         @default(now()) @map("redeemed_at")
  usedAt      DateTime?        @map("used_at")

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward   Reward @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@map("redemptions")
}

// ──────────────────────────── Config ─────────────────────────

// Singleton row (id = 1)
model SalonSetting {
  id                    Int     @id @default(1)
  salonName             String  @default("Salon Shop") @map("salon_name")
  cancellationWindowHrs Int     @default(2) @map("cancellation_window_hrs")
  loyaltyPointsPerVisit Int     @default(10) @map("loyalty_points_per_visit")
  slotBufferMinutes     Int     @default(15) @map("slot_buffer_minutes")
  openingHours          Json?   @map("opening_hours") // [{ "weekday": 1, "startMinute": 540, "endMinute": 1080 }]
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("salon_settings")
}
